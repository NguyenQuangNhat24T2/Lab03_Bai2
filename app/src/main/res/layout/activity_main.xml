<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HỒ SƠ NGƯỜI DÙNG"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#212529"
        android:layout_marginBottom="30dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Họ và tên hiện tại:"
        android:textSize="16sp"
        android:textColor="#6C757D" />

    <!-- Hiển thị họ tên hiện tại (Mặc định: 'Chưa có thông tin') -->
    <TextView
        android:id="@+id/tvCurrentName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chưa có thông tin"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#0D6EFD"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="40dp" />

    <!-- Nút bấm Chỉnh sửa thông tin -->
    <Button
        android:id="@+id/btnEditProfile"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Chỉnh sửa thông tin"
        android:textSize="16sp"
        android:backgroundTint="#0D6EFD" />

</LinearLayout>